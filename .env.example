# Backend
PORT=3000
JWT_SECRET=change-me-jwt-secret
# Vida del token en segundos (15 min)
JWT_TTL_SECONDS=900
WEBHOOK_SECRET=change-me-webhook-secret
DB_PATH=./data/orbita.sqlite
# Intentos fallidos de login antes de bloquear el email, y duración del bloqueo
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_SECONDS=300
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Docker Compose (puertos expuestos en el host)
BACKEND_PORT=3000
FRONTEND_PORT=8080
